{
	"name": "hakili",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "pnpm test:unit -- --run && pnpm test:e2e",
		"test:e2e": "playwright install && playwright test",
		"db:up": "docker compose up -d",
		"db:down": "docker compose down",
		"ingest": "tsx scripts/ingest-kenya.ts",
		"ingest:force": "tsx scripts/ingest-kenya.ts --force",
		"eval": "tsx scripts/eval-harness.ts",
		"eval:live": "tsx scripts/eval-harness.ts --live",
		"expansions:build": "tsx scripts/build-expansions.ts",
		"corpus:build": "tsx scripts/build-corpus.ts && prettier --write src/lib/data/kenyan-legal-corpus.json",
		"corpus:check": "node scripts/check-corpus.mjs",
		"ner:fetch": "node scripts/fetch-ner-models.mjs",
		"mt:convert": "python3 scripts/convert-mt-en-sw.py",
		"mt:fetch": "node scripts/fetch-mt-models.mjs",
		"ner:convert": "python3 scripts/convert-swahili-ner.py",
		"postinstall": "node scripts/postinstall.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.61.0",
		"@playwright/test": "^1.60.0",
		"@shadcn-svelte/primitives": "^0.0.1",
		"@shadcn/lint": "^0.2.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"@types/pg": "^8.23.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"svelte-eslint-parser": "^1.8.1",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.19.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@huggingface/transformers": "^4.3.1",
		"@qvac/sdk": "^0.22.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"bits-ui": "^2.20.2",
		"chrono-node": "^2.10.3",
		"clsx": "^2.1.1",
		"cn": "^0.4.0",
		"compromise": "^14.19.0",
		"compromise-dates": "^3.10.0",
		"compromise-numbers": "^1.4.0",
		"filepond": "5.0.0-beta.74",
		"franc": "^6.2.0",
		"mammoth": "^1.13.0",
		"mode-watcher": "^1.1.0",
		"onnxruntime-node": "1.30.0",
		"pdfjs-dist": "^6.4.299",
		"pg": "^8.13.0",
		"phosphor-svelte": "^3.1.1",
		"require-asset": "^1.2.4",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tesseract.js": "^7.0.0",
		"tw-animate-css": "^1.4.0",
		"wink-ner": "^2.1.0",
		"wink-tokenizer": "^5.3.0"
	}
}
